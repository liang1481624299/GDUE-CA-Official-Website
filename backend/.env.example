# ===== 数据库 =====
# 默认 SQLite（无需额外配置），切换 PostgreSQL 填下面这行：
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./assoc.db

# ===== JWT =====
# 生产环境必须改成长随机字符串，可用：python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ===== 安全 =====
# 允许的前端域名（CORS，逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 允许访问的 Host（逗号分隔），留空则不校验
ALLOWED_HOSTS=

# ===== 超级管理员初始化 =====
# 首次启动时若数据库无管理员，会自动按以下信息创建一个
FIRST_SUPERADMIN_EMAIL=admin@gdue-ca.cn
FIRST_SUPERADMIN_PASSWORD=ChangeMe123!
